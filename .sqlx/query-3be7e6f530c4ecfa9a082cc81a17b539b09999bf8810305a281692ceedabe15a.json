  "db_name": "PostgreSQL",
  "query": "\nSELECT\n  Characters.id,\n  Characters.name,\n  Characters.apparent_age,\n  Characters.date_embraced,\n  Characters.torpor_time,\n  Clans.name AS clan_name,\n  COALESCE(XPRemaining.amount, 0) AS \"remaining_xp!\"\nFROM Characters\nJOIN Clans ON Clans.id = Characters.clan\nJOIN XPRemaining ON XPRemaining.character = Characters.id\n    ",
